From 427994808baa09bfe233cf2ad98efa53ffe27716 Mon Sep 17 00:00:00 2001
From: Claude <claude@example.com>
Date: Thu, 15 Oct 2026 09:25:37 +0000
Subject: [PATCH] Patch 9: sort newest first with a plain SQL sort order

QUERY_ARG_SORT_COLUMNS/DIRECTION were ignored by MediaProvider, returning oldest first.
---
 .../femi/gallery/data/mediastore/MediaStoreDataSource.kt | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/app/src/main/java/com/femi/gallery/data/mediastore/MediaStoreDataSource.kt b/app/src/main/java/com/femi/gallery/data/mediastore/MediaStoreDataSource.kt
index dee3cae..86d59d4 100644
--- a/app/src/main/java/com/femi/gallery/data/mediastore/MediaStoreDataSource.kt
+++ b/app/src/main/java/com/femi/gallery/data/mediastore/MediaStoreDataSource.kt
@@ -71,11 +71,12 @@ class MediaStoreDataSource @Inject constructor(
         // ordering. DATE_ADDED is always set and matches the capture time for camera photos.
         // MediaProvider rejects expressions like COALESCE in sort order, so a perfect
         // "date taken, else modified" ordering will come later from our own index.
-        putStringArray(
-            ContentResolver.QUERY_ARG_SORT_COLUMNS,
-            arrayOf(MediaStore.MediaColumns.DATE_ADDED, MediaStore.MediaColumns._ID),
+        // Note: QUERY_ARG_SORT_COLUMNS/DIRECTION are ignored here (results came back oldest
+        // first), so we pass a plain SQL sort clause instead.
+        putString(
+            ContentResolver.QUERY_ARG_SQL_SORT_ORDER,
+            "${MediaStore.MediaColumns.DATE_ADDED} DESC, ${MediaStore.MediaColumns._ID} DESC",
         )
-        putInt(ContentResolver.QUERY_ARG_SORT_DIRECTION, ContentResolver.QUERY_SORT_DIRECTION_DESCENDING)
     }
 
     private class Columns(cursor: Cursor) {
-- 
