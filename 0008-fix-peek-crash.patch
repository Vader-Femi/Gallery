From 9cb7d93942489c646843feda3c44a806657cbc59 Mon Sep 17 00:00:00 2001
From: Claude <claude@example.com>
Date: Thu, 15 Oct 2026 09:02:53 +0000
Subject: [PATCH] Patch 8: fix crash when peeking the first item before the
 list has loaded

---
 .../com/femi/gallery/presentation/pictures/PicturesScreen.kt    | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/app/src/main/java/com/femi/gallery/presentation/pictures/PicturesScreen.kt b/app/src/main/java/com/femi/gallery/presentation/pictures/PicturesScreen.kt
index e6a8df0..1a1b13e 100644
--- a/app/src/main/java/com/femi/gallery/presentation/pictures/PicturesScreen.kt
+++ b/app/src/main/java/com/femi/gallery/presentation/pictures/PicturesScreen.kt
@@ -51,7 +51,7 @@ fun PicturesScreen(
     val gridState = rememberLazyGridState()
 
     // When a newer photo arrives, jump to it if the user is already near the top.
-    val newestId = items.peek(0)?.id
+    val newestId = if (items.itemCount > 0) items.peek(0)?.id else null
     LaunchedEffect(newestId) {
         if (newestId != null && gridState.firstVisibleItemIndex < 24) gridState.scrollToItem(0)
     }
