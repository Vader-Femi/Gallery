From 0793f4d937b0efad1137f2f5a29c3329c75af8bb Mon Sep 17 00:00:00 2001
From: Claude <claude@example.com>
Date: Sat, 17 Oct 2026 11:04:25 +0000
Subject: [PATCH] Patch 20: keep the Locked folder's screenshot protection on
 while screens overlap

Navigating from the locked album to its viewer composed both screens at once; the album
disposing cleared FLAG_SECURE that the viewer had just set. SecureWindow now counts users
and only clears the flag when the last one leaves.
---
 .../femi/gallery/presentation/locked/LockedGate.kt  | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/com/femi/gallery/presentation/locked/LockedGate.kt b/app/src/main/java/com/femi/gallery/presentation/locked/LockedGate.kt
index 38b5878..a353391 100644
--- a/app/src/main/java/com/femi/gallery/presentation/locked/LockedGate.kt
+++ b/app/src/main/java/com/femi/gallery/presentation/locked/LockedGate.kt
@@ -96,13 +96,24 @@ private fun LockedPlaceholder(available: Boolean, onUnlock: () -> Unit, onClose:
     }
 }
 
+/**
+ * How many [SecureWindow]s are currently on screen. Screens overlap while navigating (the album
+ * is still composed while the viewer opens on top of it), so the flag may only be cleared when
+ * the last one leaves; otherwise the album disposing would switch off the viewer's protection.
+ */
+private var secureWindowCount = 0
+
 /** Blocks screenshots, screen recording and the recent-apps thumbnail while this is composed. */
 @Composable
 fun SecureWindow() {
     val view = LocalView.current
     DisposableEffect(view) {
         val window = view.context.findActivity()?.window
+        secureWindowCount++
         window?.addFlags(WindowManager.LayoutParams.FLAG_SECURE)
-        onDispose { window?.clearFlags(WindowManager.LayoutParams.FLAG_SECURE) }
+        onDispose {
+            secureWindowCount = maxOf(0, secureWindowCount - 1)
+            if (secureWindowCount == 0) window?.clearFlags(WindowManager.LayoutParams.FLAG_SECURE)
+        }
     }
 }
