+fun BoxScope.SelectionBars(
+    count: Int,
+    allFavorite: Boolean,
+    onClose: () -> Unit,
+    onSelectAll: () -> Unit,
+    onShare: () -> Unit,
+    onFavorite: () -> Unit,
