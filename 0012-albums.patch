+        putString(ContentResolver.QUERY_ARG_SQL_SELECTION, selection.toString())
+        putStringArray(ContentResolver.QUERY_ARG_SQL_SELECTION_ARGS, selectionArgs.toTypedArray())
         if (sorted) {
