From abb1cf46bf031f128b6ed05a01959f5df60d68dd Mon Sep 17 00:00:00 2001
From: Claude <claude@example.com>
Date: Thu, 15 Oct 2026 08:05:30 +0000
Subject: [PATCH] Fix: upgrade Kotlin to 2.4.10 to match dependency metadata

AGP 9 built-in Kotlin defaults to KGP 2.2.10, which cannot read kotlin-stdlib 2.4.x
metadata pulled in by newer dependencies. Override the KGP version via the root
buildscript classpath and align the Compose compiler plugin version.
---
 build.gradle.kts          | 13 +++++++++++++
 gradle/libs.versions.toml |  2 +-
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/build.gradle.kts b/build.gradle.kts
index d58b870..97b4f61 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -1,3 +1,16 @@
+// AGP 9 bundles Kotlin Gradle Plugin 2.2.10. Some dependencies (e.g. Coil, Compose) are now built
+// with Kotlin 2.4, so the compiler must be upgraded too. Keep this in sync with `kotlin` in
+// gradle/libs.versions.toml.
+buildscript {
+    repositories {
+        google()
+        mavenCentral()
+    }
+    dependencies {
+        classpath("org.jetbrains.kotlin:kotlin-gradle-plugin:2.4.10")
+    }
+}
+
 // Top-level build file where you can add configuration options common to all sub-projects/modules.
 plugins {
     alias(libs.plugins.android.application) apply false
diff --git a/gradle/libs.versions.toml b/gradle/libs.versions.toml
index 8e92342..a52f95d 100644
--- a/gradle/libs.versions.toml
+++ b/gradle/libs.versions.toml
@@ -6,7 +6,7 @@ junitVersion = "1.1.5"
 espressoCore = "3.5.1"
 lifecycleRuntimeKtx = "2.6.1"
 activityCompose = "1.8.0"
-kotlin = "2.2.10"
+kotlin = "2.4.10"
 composeBom = "2026.02.01"
 lifecycle = "2.9.4"
 navigationCompose = "2.9.5"
-- 
2.43.0

