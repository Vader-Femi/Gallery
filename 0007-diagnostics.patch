 .../data/mediastore/MediaStoreDataSource.kt   |  3 ++
 .../femi/gallery/domain/model/MediaItem.kt    |  1 +
 .../presentation/pictures/PicturesScreen.kt   | 29 +++++++++++++++++++
 4 files changed, 51 insertions(+), 11 deletions(-)

diff --git a/app/src/main/java/com/femi/gallery/data/image/MediaThumbnailFetcher.kt b/app/src/main/java/com/femi/gallery/data/image/MediaThumbnailFetcher.kt
index 788f1fc..50c4556 100644
--- a/app/src/main/java/com/femi/gallery/data/image/MediaThumbnailFetcher.kt
+++ b/app/src/main/java/com/femi/gallery/data/image/MediaThumbnailFetcher.kt
@@ -2,6 +2,7 @@ package com.femi.gallery.data.image
 
 import android.content.ContentResolver
 import android.net.Uri
+import android.util.Log
 import android.util.Size
 import coil3.ImageLoader
 import coil3.Uri as CoilUri
@@ -24,17 +25,23 @@ class MediaThumbnailFetcher(
     private val options: Options,
 ) : Fetcher {
 
-    override suspend fun fetch(): FetchResult = withContext(Dispatchers.IO) {
-        val bitmap = options.context.contentResolver.loadThumbnail(
-            Uri.parse(data.toString()),
-            Size(THUMBNAIL_SIZE, THUMBNAIL_SIZE),
-            null,
-        )
-        ImageFetchResult(
-            image = bitmap.asImage(),
-            isSampled = true,
-            dataSource = DataSource.DISK,
-        )
+    override suspend fun fetch(): FetchResult? = withContext(Dispatchers.IO) {
+        try {
+            val bitmap = options.context.contentResolver.loadThumbnail(
+                Uri.parse(data.toString()),
+                Size(THUMBNAIL_SIZE, THUMBNAIL_SIZE),
+                null,
+            )
+            ImageFetchResult(
+                image = bitmap.asImage(),
+                isSampled = true,
+                dataSource = DataSource.DISK,
+            )
+        } catch (e: Exception) {
+            // No system thumbnail (yet): log it and let Coil's default fetcher decode the file.
+            Log.w("MediaThumbnailFetcher", "loadThumbnail failed for $data", e)
+            null
+        }
     }
 
     class Factory : Fetcher.Factory<CoilUri> {
