<?xml version="1.0" encoding="utf-8"?>
<!--
    The video player of the photo viewer. It has to be made from XML because the surface type can only
    be chosen there: a texture view is part of the window like any other view, so it is transparent
    (the thumbnail underneath shows) until the first frame arrives. The default surface view is
    composited behind the window and shows solid black until then, which is the flash on opening a video.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:resize_mode="fit"
    app:shutter_background_color="@android:color/transparent"
    app:surface_type="texture_view"
    app:use_controller="false" />
