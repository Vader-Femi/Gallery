<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Elevated dark container with 16dp rounded corners -->
    <solid android:color="#F21E1E24" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
    <padding
        android:top="8dp"
        android:bottom="8dp"
        android:left="4dp"
        android:right="4dp" />
</shape>
